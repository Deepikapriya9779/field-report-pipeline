# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Model used for extraction and the weekly narrative.
ANTHROPIC_MODEL=claude-sonnet-5-5
# mock   = replay recorded responses from tests/fixtures/llm (default when no API key is set)
# record = call the API and save each response as a fixture
# live   = call the API, save nothing
LLM_MODE=mock
# SQLite database path used by the CLI.
FIELDREPORTS_DB=fieldreports.db
